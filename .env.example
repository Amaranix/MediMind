# Copier en .env puis remplacer chaque valeur « a-changer ». Ne jamais committer .env.

# Base de données
POSTGRES_USER=medimind
POSTGRES_PASSWORD=a-changer
POSTGRES_DB=medimind

# Signature des jetons de session : 32 caractères aléatoires minimum
# (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=a-changer

# Compte administrateur créé au premier démarrage (gestion des comptes, aucun accès aux patients)
ADMIN_EMAIL=admin@medimind.local
ADMIN_PASSWORD=a-changer

# LLM local (Ollama sur la machine hôte)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Adresse et port HTTPS
SITE_ADDRESS=localhost:8443
HTTPS_PORT=8443
